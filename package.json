{
  "name": "next13-boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:tsc": "tsc -p . --noEmit",
    "lint:staged": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "sh ./.husky/pre-commit",
      "pre-push": "sh ./.husky/pre-push",
      "commit-msg": "sh ./.husky/commit-msg"
    }
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "axios": "^1.20.0",
    "framer-motion": "^14.6.0",
    "next": "16.4.2",
    "next-auth": "^4.24.15",
    "qs": "^6.16.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "react-select": "^5.10.2",
    "react-use": "^17.6.1",
    "sass": "^1.106.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "typed.js": "^3.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "clsx": "^2.1.1",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.2"
  },
  "browser": {
    "buffer": false
  }
}
